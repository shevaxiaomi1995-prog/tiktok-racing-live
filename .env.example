PORT=8787
# Set a long random secret before exposing the event server publicly.
EVENT_INGEST_TOKEN=replace-with-a-long-random-secret
# Keep true only for local testing. Set false on a public deployment.
ALLOW_DEMO_EVENTS=true
# Optional: set this when the event server is hosted separately from the web app.
# VITE_WS_URL=wss://your-event-server.example/ws
